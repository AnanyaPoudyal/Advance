CSS

@charset "ISO-8859-1";
body {
  font-family: "Trebuchet MS", Helvetica, sans-serif;
  margin: 0;
  padding: 0;
  color: #0d2441;
}

nav {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.navigation_bar {
  display: flex;
  width: 100%;
  height: 80px;
}

.search-container {
	background: #fff;
    padding: .3rem .8rem;
    border-radius: 20px;
    border: 1px solid #333;
    width: 500px;
    display: flex;
    justify-content: space-between;
}

.search-container button {
    outline: 0;
    border: 0;
    background: #fff;
    cursor: pointer;
}

.search-container input {
    padding: .3rem;
    border: 0;
    outline: 0;
    background: #fff;
    width: 100%;
}


.logo {
  margin: auto;
  font-size: 30px;
  margin-left: 3%;
  width: 20%;
}

table {
  margin: auto;

}

table td a {
  font-size: 20px;
  padding: 15px;
  text-decoration: none;
  color: #0d2441;
}

table tr {
  list-style-type: none;
  float: right;
  padding-right: 50px;
}

table td {
  float: right;
  padding: 15px;
}

table td:hover {
  display: inline;
  font-size: 20px;
  text-decoration: none;
  color: white;

  background-color: #9b59b6;
  border-radius: 0.3rem;
}

table td a:hover {
  color: white;
}

.title {
   display: inline-;
    padding-top: 10px;
    padding-bottom: 10px;
    font-size: 30px;
    text-align: center;
    color: white;
    background-color: #5f84d4;
  }
.main {
  width: 100%;
  display: flex;
  background-color: red;
  margin-top: -200px;
}

.container {
  width: 1000px;
  display: flex;
  flex-wrap: nowrap;
  margin: 20px auto;

}

.flex-box {

  width: 200px;
  display: flex;
  margin: 10px;
}

.flex-image {

            width: inherit;
            height: 700px;
           
}

.flex-image img {
             width: 100%;
             height: 400px;
             box-sizing: border-box;
             object-fit: cover;
            
}

.flex-image h1 {
	color: black;
	text-align: center;
	text-transform: capitalize;
    font-size: 18px;
    font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
}


.arrows {
  box-shadow: 1px 1px 5px 5px rgba(167, 161, 161, 0.15);
  margin: auto;
  width: 50px;
  height: 50px;
  border-radius: 50%;
}

.arrows p i {
  margin-left: auto;
  margin-right: auto;
  display: block;
  width: 7px;
  height: 7px;
}

.policy {
  padding: 12px;
  background-color: #8dd0f7;
  width: auto;
  color: #0d2441;
  height: 218px;
  display: flex;
}

.team {
  font-family: Verdana, Geneva, Tahoma, sans-serif;
  width: 25%;
  height: auto;
  font-size: 15px;
}

.help {
  font-family: Verdana, Geneva, Tahoma, sans-serif;
  width: 25%;
  height: auto;
  font-size: 15px;
}

.policy-center {
  font-family: Verdana, Geneva, Tahoma, sans-serif;
  width: 25%;
  height: auto;
  font-size: 15px;
}

.company {
  font-family: Verdana, Geneva, Tahoma, sans-serif;
  width: 25%;
  height: auto;
  font-size: 15px;
}

.company li,
.policy-center li,
.help li,
.team li {
  list-style-type: none;
  margin-left: 25%;
  padding-top: 15px;
}

.help p,
.policy p,
.team p,
.company p {
  margin-left: 30%;
  font-weight: bold;
}

.our-services-block {
  width: 90%;
  margin-left: 5%;
  margin-right: 5%;

  margin-top: 20px;
  color: #0d2441;
  height: 250px;
  display: flex;
}

.delivery,
.quality,
.messages {
  display: flex;
  box-shadow: 0.1px 0.1px 5px 5px rgba(167, 161, 161, 0.15);
  margin: 20px;
  font-family: Verdana, Geneva, Tahoma, sans-serif;
  width: 33.3%;
  font-size: 15px;
}

.delivery-icon,
.quality-icon,
.messages-icon {
  border-radius: 50%;
  margin: auto;
  border: 1px solid rgb(204, 204, 204);
}

.delivery-icon i,
.quality-icon i,
.messages-icon i {
  position: relative;
  font-size: 35px;
  padding: 15px;
  color: #0d2441;
}

.delivery-details,
.quality-details,
.messages-details {
  width: 65%;
  margin-top: auto;
  margin-bottom: auto;
}

.delivery-details h1,
.quality-details h1,
.messages-details h1 {
  font-family: "Courier New", Courier, monospace;
  font-size: 25px;
  letter-spacing: 1px;
}

.delivery-details p,
.quality-details p,
.messages-details p {
  font-family: "Courier New", Courier, monospace;
  font-size: 16px;
  letter-spacing: 1px;
  color: black;
}

.fa {
  padding: 8px;
  width: 8%;
  height: auto;
  text-align: center;
  text-decoration: none;
  margin: 5px 2px;
  border-radius: 50%;
}

.fa:hover {
  opacity: 1.5;
}

.fa-facebook {
  background: #3b5998;
  color: white;
}

.fa-twitter {
  background: #55acee;
  color: white;
}

.fa-google {
  background: #dd4b39;
  color: white;
}

footer {
  display: flex;
  width: 100%;
  color: white;
}

.footer-logo {
  width: 40%;
}

.footer-logo p {
  color: #0d2441;
  font-size: 20px;
  margin: auto;
  padding: 10px;
  padding-left: 100px;
}

.footer {
  width: 50%;
}

.footer p {
  margin-left: 9%;
  color: rgb(112, 112, 112);
  font-size: 12px;
  text-align: center;
  padding: 5px;
}

.social-medias {
  padding-top: 5px;
  padding-left: 10%;
  width: 40%;
}

.dark-mode {
  background-color: black;
  color: white;
}

