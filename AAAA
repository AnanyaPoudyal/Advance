	public int registerUser(String query, User user) {
		Connection dbConnection = getConnection();
		if(dbConnection != null) {
			try {
				if(isUserAlreadyRegistered(user.getUname())) return -1;
				
				PreparedStatement statement = dbConnection.prepareStatement(query);
				statement.setString(1, user.getFname());
				statement.setString(2, user.getLname());
				statement.setString(3, user.getUname());
				statement.setString(4, PasswordEncryptionWithAes.encrypt(
						user.getUname(), user.getPassword()));
//				statement.setString(5, userModel.getRole());
//				statement.setString(6, userModel.getImageUrlFromPart());

				int result = statement.executeUpdate();
				if(result>=0) return 1;
				else return 0;
			} catch (Exception e) { return -2; }
		}else { return -3; }
	}
