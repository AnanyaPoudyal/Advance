@charset "ISO-8859-1";

body{
	background-color: #9BA49E;
	font-family: monospace;
	display: flex;
	justify-content: center;
	align-items: center;
	height: 100vh;
	position: absolute;
	top: 50%;
	left: 50%;
	width:350px;
	padding:50px;
	transform: translate(-50% , -50%); 
	
}

h1{
	text-decoration: underline;
}

form{
	padding: 2% 5% 3% 5%;
	display: block;
	width: 10%;
	margin: 0 auto;
	text-align: center;
	box-shadow: 0 0 10px 5px white;
}

input {
	height: 25px;
	display: inline-block;
}
