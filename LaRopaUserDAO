		public String laRopaUserinsert(LaropaUser laropaUser) {
				
				
				DAO connDAO = new DAO();
				connDAO.loadDriver(connDAO.dbDriver);
				Connection laRopaCon = connDAO.getConnection();
				String resultUser = "Date Entered Successfully";
				String userInsertSQL = "insert into user(fname, lname, phone, uname, password) values(?,?,?,?,?)";
				PreparedStatement ps;
				try {
					ps = laRopaCon.prepareStatement(userInsertSQL);
	
					ps.setString(1, laropaUser.getFname());
					ps.setString(2, laropaUser.getLname());
					ps.setInt(3, laropaUser.getPhone());
					ps.setString(4, laropaUser.getUname());
					ps.setString(5, laropaUser.getPassword());
					ps.executeUpdate();
				} catch (SQLException e) {
					// TODO Auto-generated catch block
					e.printStackTrace();
					resultUser = "Data not Entered";
				}
				
				return resultUser;
			}
		
