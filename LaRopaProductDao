import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.SQLException;

public class LaRopaProductDao {
	public String laRopaProductinsert(LaropaProduct laropaProduct) {
		
		
		DAO connDAO = new DAO();
		connDAO.loadDriver(connDAO.dbDriver);
		Connection laRopaCon = connDAO.getConnection();
		String resultProduct = "Date Entered Successfully";
		String productInsertSQL = "insert into product(pname, price, brand, category, stock, size, imageUrl) values(?,?,?,?,?,?,?)";
		PreparedStatement ps;
		try {
			ps = laRopaCon.prepareStatement(productInsertSQL);

			ps.setString(1, laropaProduct.getPname());
			ps.setInt(2, laropaProduct.getPrice());
			ps.setString(3, laropaProduct.getBrand());
			ps.setString(4, laropaProduct.getCategory());
			ps.setInt(5, laropaProduct.getStock());
			ps.setString(6, laropaProduct.getSize());
			ps.setString(7, laropaProduct.getImageUrl());
			ps.executeUpdate();
		} catch (SQLException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
			resultProduct = "Data not Entered";
		}
		
		return resultProduct;
	}

